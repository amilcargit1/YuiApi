<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title><%= title %> · YuiAPI</title><link rel="stylesheet" href="/css/style.css"/></head><body class="app-body"><div class="app-shell"><aside class="sidebar"><a href="/" class="brand">Yui<span>API</span></a><nav class="sidebar-nav"><p class="sidebar-label">General</p><a href="/dashboard" class="<%= active === 'overview' ? 'active' : '' %>">📊 Resumen</a><a href="/dashboard/keys" class="<%= active === 'keys' ? 'active' : '' %>">🔑 API Keys</a><a href="/dashboard/logs" class="<%= active === 'logs' ? 'active' : '' %>">📜 Historial</a><a href="/dashboard/endpoints" class="<%= active === 'endpoints' ? 'active' : '' %>">🧩 Endpoints</a><a href="/docs" class="<%= active === 'docs' ? 'active' : '' %>">📘 Documentación</a><% if (user && user.role === 'admin') { %><p class="sidebar-label">Administración</p><a href="/admin" class="<%= active === 'admin' ? 'active' : '' %>">🛠️ Panel admin</a><a href="/admin/users" class="<%= active === 'admin-users' ? 'active' : '' %>">👥 Usuarios</a><a href="/admin/logs" class="<%= active === 'admin-logs' ? 'active' : '' %>">🗂️ Logs del sistema</a><% } %></nav><div class="sidebar-footer"><div class="user-chip"><span class="avatar"><%= user.username.charAt(0).toUpperCase() %></span><div><strong><%= user.username %></strong><small><%= user.planName %> · <%= user.role %></small></div></div><form action="/logout" method="POST"><button type="submit" class="btn btn-outline btn-block">Cerrar sesión</button></form></div></aside><div class="app-content">
