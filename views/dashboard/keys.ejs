<%- include('../partials/app-shell-start', { active: 'keys' }) %>
<div class="content-header"><h1>API Keys</h1></div><% if (newKey) { %><div class="card" style="margin-bottom:1.5rem;border-color:var(--accent);"><h3>✅ Tu nueva API key</h3><p style="margin-bottom:0.75rem;">Guárdala ahora, no volverá a mostrarse completa:</p><p class="key-display"><%= newKey %></p></div><% } %><div class="card" style="margin-bottom:1.5rem;"><h3>Crear nueva key</h3><form method="POST" action="/dashboard/keys"><input type="text" name="name" placeholder="Nombre (ej: producción, pruebas...)" /><button type="submit" class="btn btn-primary">+ Generar key</button></form></div><div class="table-wrapper"><table><thead><tr><th>Nombre</th><th>Prefijo</th><th>Estado</th><th>Solicitudes</th><th>Último uso</th><th>Creada</th><th>Acciones</th></tr></thead><tbody><% apiKeys.forEach(function(key) { %><tr><td><%= key.name %></td><td><code><%= key.keyPrefix %>...</code></td><td><span class="badge <%= key.revoked ? 'danger' : 'success' %>"><%= key.revoked ? 'Revocada' : 'Activa' %></span></td><td><%= key.requestCount %></td><td><%= key.lastUsedAt ? new Date(key.lastUsedAt).toLocaleString('es-ES') : 'Nunca' %></td><td><%= new Date(key.createdAt).toLocaleDateString('es-ES') %></td><td><% if (!key.revoked) { %><form method="POST" action="/dashboard/keys/<%= key.id %>/revoke"><button type="submit" class="btn btn-outline btn-sm">Revocar</button></form><% } %><form method="POST" action="/dashboard/keys/<%= key.id %>/delete"><button type="submit" class="btn btn-danger btn-sm">Eliminar</button></form></td></tr><% }); %><% if (apiKeys.length === 0) { %><tr><td colspan="7">No tienes API keys todavía.</td></tr><% } %></tbody></table></div><%- include('../partials/app-shell-end') %>
