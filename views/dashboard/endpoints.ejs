<%- include('../partials/app-shell-start', { active: 'endpoints' }) %>
<div class="content-header"><h1>Catálogo de endpoints</h1><input class="search-box" type="text" id="endpointSearch" placeholder="Buscar endpoint..." onkeyup="filterEndpoints()" /></div><div id="endpointList" class="grid"><% endpoints.forEach(function(ep) { %><div class="card endpoint-card" data-name="<%= ep.meta.name.toLowerCase() %> <%= ep.meta.path.toLowerCase() %>"><div class="endpoint-row"><span class="method-tag method-<%= ep.meta.method %>"><%= ep.meta.method %></span><strong><%= ep.meta.path %></strong></div><p style="margin:0.5rem 0;"><%= ep.meta.description %></p><p style="font-size:0.8rem;color:var(--text-muted);">Categoría: <%= ep.meta.category %> · Auth: <%= ep.meta.auth ? 'requerida' : 'no requerida' %> · v<%= ep.meta.version %></p></div><% }); %></div><script>function filterEndpoints(){const q=document.getElementById('endpointSearch').value.toLowerCase();document.querySelectorAll('.endpoint-card').forEach(function(card){card.style.display=card.dataset.name.includes(q)?'':'none';});}</script><%- include('../partials/app-shell-end') %>
