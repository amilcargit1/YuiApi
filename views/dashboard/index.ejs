<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/style.css"><title>Dashboard · YuiAPI</title></head><body><div class="shell"><aside><h2>YuiAPI</h2><a>Overview</a><a href="/docs">Documentation</a><a href="/dashboard">Analytics</a><a href="/admin">Admin</a></aside><main class="content"><p class="eyebrow">DASHBOARD</p><h1>Control center</h1><div id="stats" class="grid"></div></main></div><script>fetch('/api/v1/dashboard/stats').then(r=>r.json()).then(x=>{if(!x.status)location='/login';else{const d=x.data;document.querySelector('#stats').innerHTML=Object.entries(d).slice(0,5).map(([k,v])=>'<article><small>'+k+'</small><h2>'+v+'</h2></article>').join('')}})</script></body></html>
