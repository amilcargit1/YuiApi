<%- include('../partials/app-shell-start', { active: 'overview' }) %>
<div class="content-header"><h1>Resumen</h1><a href="/dashboard/keys" class="btn btn-primary">+ Nueva API Key</a></div><div class="stat-grid"><div class="stat-card"><div class="label">Requests totales</div><div class="value"><%= stats.totalRequests %></div></div><div class="stat-card"><div class="label">Requests hoy</div><div class="value"><%= stats.requestsToday %></div></div><div class="stat-card"><div class="label">Exitosos</div><div class="value" style="color:var(--success)"><%= stats.successfulRequests %></div><div class="bar"><span style="width:<%= stats.totalRequests ? Math.round((stats.successfulRequests/stats.totalRequests)*100) : 0 %>%;background:var(--success)"></span></div></div><div class="stat-card"><div class="label">Fallidos</div><div class="value" style="color:var(--danger)"><%= stats.failedRequests %></div><div class="bar"><span style="width:<%= stats.totalRequests ? Math.round((stats.failedRequests/stats.totalRequests)*100) : 0 %>%;background:var(--danger)"></span></div></div><div class="stat-card"><div class="label">Latencia promedio</div><div class="value"><%= stats.averageLatencyMs %> ms</div></div><div class="stat-card"><div class="label">API Keys activas</div><div class="value"><%= stats.activeApiKeys %></div></div></div><div class="grid" style="grid-template-columns:1.3fr 1fr;align-items:start;"><div class="table-wrapper"><table><thead><tr><th>Endpoint</th><th>Método</th><th>Estado</th><th>Duración</th><th>Fecha</th></tr></thead><tbody><% recentActivity.forEach(function(log) { %><tr><td><%= log.endpoint %></td><td><span class="method-tag method-<%= log.method %>"><%= log.method %></span></td><td><span class="badge <%= log.statusCode < 400 ? 'success' : 'danger' %>"><%= log.statusCode %></span></td><td><%= log.durationMs %> ms</td><td><%= new Date(log.createdAt).toLocaleString('es-ES') %></td></tr><% }); %><% if (recentActivity.length === 0) { %><tr><td colspan="5">Aún no hay actividad. Crea una API key y haz tu primera solicitud.</td></tr><% } %></tbody></table></div><div class="card"><h3>Endpoints más usados</h3><% if (stats.topEndpoints.length === 0) { %><p style="color:var(--text-muted);font-size:0.85rem;">Sin datos todavía.</p><% } %><% stats.topEndpoints.forEach(function(e) { %><p style="display:flex;justify-content:space-between;font-size:0.88rem;margin:0.5rem 0;"><span><%= e.endpoint %></span><strong><%= e.count %></strong></p><% }); %></div></div><%- include('../partials/app-shell-end') %>
