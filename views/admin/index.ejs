<%- include('../partials/app-shell-start', { active: 'admin' }) %>
<div class="content-header"><h1>Panel de administración</h1></div><div class="stat-grid"><div class="stat-card"><div class="label">Requests totales</div><div class="value"><%= globalStats.totalRequests %></div></div><div class="stat-card"><div class="label">Requests hoy</div><div class="value"><%= globalStats.requestsToday %></div></div><div class="stat-card"><div class="label">Exitosos</div><div class="value" style="color:var(--success)"><%= globalStats.successfulRequests %></div></div><div class="stat-card"><div class="label">Fallidos</div><div class="value" style="color:var(--danger)"><%= globalStats.failedRequests %></div></div><div class="stat-card"><div class="label">Latencia promedio</div><div class="value"><%= globalStats.averageLatencyMs %> ms</div></div><div class="stat-card"><div class="label">Endpoints registrados</div><div class="value"><%= endpointCount %></div></div></div><div class="grid" style="grid-template-columns:1fr 1fr;align-items:start;"><div class="card"><h3>Categorías</h3><% categories.forEach(function(cat) { %><p style="display:flex;justify-content:space-between;font-size:0.9rem;margin:0.5rem 0;"><span><%= cat.category %></span><strong><%= cat.count %> endpoints</strong></p><% }); %></div><div class="card"><h3>Planes</h3><% plans.forEach(function(plan) { %><p style="display:flex;justify-content:space-between;font-size:0.9rem;margin:0.5rem 0;"><span style="text-transform:capitalize;"><%= plan.name %></span><strong><%= plan.dailyRequests.toLocaleString('es-ES') %>/día</strong></p><% }); %></div></div><div class="content-header" style="margin-top:2rem;"><h1 style="font-size:1.2rem;">Usuarios recientes</h1><a href="/admin/users" class="btn btn-outline">Ver todos</a></div><div class="table-wrapper"><table><thead><tr><th>Usuario</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Registrado</th></tr></thead><tbody><% recentUsers.forEach(function(u) { %><tr><td><%= u.username %></td><td><%= u.email %></td><td><span class="badge"><%= u.role %></span></td><td><span class="badge <%= u.status === 'active' ? 'success' : 'danger' %>"><%= u.status %></span></td><td><%= new Date(u.createdAt).toLocaleDateString('es-ES') %></td></tr><% }); %></tbody></table></div><%- include('../partials/app-shell-end') %>
