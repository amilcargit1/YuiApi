<%- include('../partials/app-shell-start', { active: 'admin-users' }) %>
<div class="content-header"><h1>Usuarios</h1><form method="GET" action="/admin/users"><input class="search-box" type="text" name="search" placeholder="Buscar por usuario o correo..." value="<%= search %>" /></form></div><div class="card" style="margin-bottom:1.5rem;"><h3>Crear usuario</h3><form method="POST" action="/admin/users" style="display:flex;gap:0.75rem;margin-top:0.75rem;flex-wrap:wrap;"><input type="text" name="username" placeholder="Usuario" required /><input type="email" name="email" placeholder="Correo" required /><input type="password" name="password" placeholder="Contraseña" required minlength="8" /><select name="role"><option value="user">user</option><option value="moderator">moderator</option><option value="admin">admin</option></select><button type="submit" class="btn btn-primary">Crear</button></form></div><div class="table-wrapper"><table><thead><tr><th>Usuario</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Plan</th><th>Acciones</th></tr></thead><tbody><% result.items.forEach(function(u) { %><tr><td><%= u.username %></td><td><%= u.email %></td><td><form method="POST" action="/admin/users/<%= u.id %>/role"><select name="role" onchange="this.form.submit()"><option value="user" <%= u.role === 'user' ? 'selected' : '' %>>user</option><option value="moderator" <%= u.role === 'moderator' ? 'selected' : '' %>>moderator</option><option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option></select></form></td><td><form method="POST" action="/admin/users/<%= u.id %>/status"><select name="status" onchange="this.form.submit()"><option value="active" <%= u.status === 'active' ? 'selected' : '' %>>active</option><option value="suspended" <%= u.status === 'suspended' ? 'selected' : '' %>>suspended</option><option value="pending" <%= u.status === 'pending' ? 'selected' : '' %>>pending</option></select></form></td><td><span class="badge"><%= u.planName %></span></td><td><small style="color:var(--text-muted)"><%= new Date(u.createdAt).toLocaleDateString('es-ES') %></small></td></tr><% }); %><% if (result.items.length === 0) { %><tr><td colspan="6">No se encontraron usuarios.</td></tr><% } %></tbody></table></div><p style="color:var(--text-muted);font-size:0.85rem;margin-top:1rem;">Página <%= result.page %> de <%= result.totalPages || 1 %> · <%= result.total %> usuarios</p><%- include('../partials/app-shell-end') %>
