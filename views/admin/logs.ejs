<%- include('../partials/app-shell-start', { active: 'admin-logs' }) %>
<div class="content-header"><h1>Logs del sistema</h1></div><form class="filters" method="GET" action="/admin/logs"><input type="text" name="endpoint" placeholder="Filtrar por endpoint" value="<%= filters.endpoint || '' %>" /><select name="statusCode"><option value="">Todos los estados</option><option value="200" <%= filters.statusCode == '200' ? 'selected' : '' %>>200</option><option value="401" <%= filters.statusCode == '401' ? 'selected' : '' %>>401</option><option value="429" <%= filters.statusCode == '429' ? 'selected' : '' %>>429</option><option value="500" <%= filters.statusCode == '500' ? 'selected' : '' %>>500</option></select><button type="submit" class="btn btn-outline">Filtrar</button></form><div class="table-wrapper"><table><thead><tr><th>Usuario</th><th>Endpoint</th><th>Método</th><th>Estado</th><th>Duración</th><th>Fecha</th></tr></thead><tbody><% history.items.forEach(function(log) { %><tr><td><small><%= log.userId || 'anónimo' %></small></td><td><%= log.endpoint %></td><td><span class="method-tag method-<%= log.method %>"><%= log.method %></span></td><td><span class="badge <%= log.statusCode < 400 ? 'success' : 'danger' %>"><%= log.statusCode %></span></td><td><%= log.durationMs %> ms</td><td><%= new Date(log.createdAt).toLocaleString('es-ES') %></td></tr><% }); %><% if (history.items.length === 0) { %><tr><td colspan="6">No hay registros para estos filtros.</td></tr><% } %></tbody></table></div><p style="color:var(--text-muted);font-size:0.85rem;margin-top:1rem;">Página <%= history.page %> de <%= history.totalPages || 1 %> · <%= history.total %> resultados</p><%- include('../partials/app-shell-end') %>
