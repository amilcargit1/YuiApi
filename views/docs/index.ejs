<%- include('../partials/header') %>
<div class="content-header" style="margin-top:1rem;"><h1>Documentación de la API</h1><div style="display:flex;gap:0.75rem;"><input class="search-box" type="text" id="docSearch" placeholder="Buscar endpoint..." onkeyup="filterDocs()"/><a href="/docs/swagger" class="btn btn-outline">Swagger UI</a><a href="/openapi.json" class="btn btn-outline">OpenAPI JSON</a></div></div><p style="color:var(--text-muted);margin-bottom:1.5rem;">Autenticación por header <code>X-API-Key</code>. Formato de respuesta estandarizado en todos los endpoints: <code>{ status, code, message, data }</code>.</p><div id="docList"><% categories.forEach(function(cat) { %><div class="section" style="margin:2rem 0;"><h2 style="text-transform:capitalize;"><%= cat.category %> <span class="badge"><%= cat.count %></span></h2><div class="grid" style="grid-template-columns:1fr;"><% endpoints.filter(function(e){return e.category===cat.category;}).forEach(function(ep){ %><div class="card doc-card" data-name="<%= ep.name.toLowerCase() %> <%= ep.path.toLowerCase() %>"><div class="endpoint-row"><span class="method-tag method-<%= ep.method %>"><%= ep.method %></span><strong><code><%= ep.path %></code></strong><span class="badge <%= ep.auth ? 'warning' : 'success' %>"><%= ep.auth ? 'Requiere API Key' : 'Público' %></span></div><p style="margin:0.6rem 0;"><%= ep.description %></p><% if(ep.params&&ep.params.length){ %><table><thead><tr><th>Parámetro</th><th>Tipo</th><th>En</th><th>Requerido</th><th>Descripción</th></tr></thead><tbody><% ep.params.forEach(function(p){ %><tr><td><%= p.name %></td><td><%= p.type %></td><td><%= p.in %></td><td><%= p.required ? 'Sí' : 'No' %></td><td><%= p.description %></td></tr><% }); %></tbody></table><% } %><p style="font-size:0.82rem;color:var(--text-muted);">Ejemplo de solicitud:</p><pre><%= ep.example_request %></pre><p style="font-size:0.82rem;color:var(--text-muted);">Ejemplo de respuesta:</p><pre><%= JSON.stringify(ep.example_response,null,2) %></pre></div><% }); %></div></div><% }); %></div><script>function filterDocs(){const q=document.getElementById('docSearch').value.toLowerCase();document.querySelectorAll('.doc-card').forEach(function(card){card.style.display=card.dataset.name.includes(q)?'':'none';});}</script><%- include('../partials/footer') %>
