<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/style.css"><title>Docs · YuiAPI</title></head><body><nav><b>YuiAPI</b><span><a href="/">Home</a><a href="/login">Login</a></span></nav><main class="docs"><div class="docs-head"><div><p class="eyebrow">DOCUMENTATION</p><h1>API Reference</h1></div><input id="search" placeholder="Buscar endpoint..."></div><div id="list"><% categories.forEach(c=>{ %><h2><%= c.name %> <small><%= c.count %></small></h2><% endpoints.filter(e=>e.category===c.name).forEach(e=>{ %><article class="endpoint"><div><b><%= e.method %></b><code><%= e.path %></code></div><p><%= e.description %></p></article><% }) %><% }) %></div></main><script>document.querySelector('#search').addEventListener('input',e=>{const q=e.target.value.toLowerCase();document.querySelectorAll('.endpoint').forEach(x=>x.style.display=x.textContent.toLowerCase().includes(q)?'':'none')})</script></body></html>
