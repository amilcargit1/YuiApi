<%- include('../partials/header') %>
<div class="auth-wrapper"><div class="auth-card"><h1>Recuperar contraseña</h1><% if (error) { %><div class="form-error"><%= error %></div><% } %><% if (sent) { %><div class="form-success">Si el correo existe en nuestro sistema, se ha generado un enlace de recuperación.</div><% if (typeof devToken !== 'undefined' && devToken) { %><p style="font-size:0.8rem;color:var(--text-muted)">Modo desarrollo — enlace directo:</p><p class="key-display"><a href="/reset-password?token=<%= devToken %>">/reset-password?token=<%= devToken %></a></p><% } %><% } else { %><form method="POST" action="/forgot-password"><div class="field"><label for="email">Correo electrónico</label><input type="email" id="email" name="email" required autofocus /></div><button type="submit" class="btn btn-primary btn-block">Enviar enlace de recuperación</button></form><% } %><p class="auth-links"><a href="/login">Volver a iniciar sesión</a></p></div></div>
<%- include('../partials/footer') %>
