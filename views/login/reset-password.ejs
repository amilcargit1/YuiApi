<%- include('../partials/header') %>
<div class="auth-wrapper"><div class="auth-card"><h1>Restablecer contraseña</h1><% if (error) { %><div class="form-error"><%= error %></div><% } %><form method="POST" action="/reset-password"><input type="hidden" name="token" value="<%= token %>" /><div class="field"><label for="password">Nueva contraseña</label><input type="password" id="password" name="password" minlength="8" required autofocus /></div><button type="submit" class="btn btn-primary btn-block">Restablecer contraseña</button></form><p class="auth-links"><a href="/login">Volver a iniciar sesión</a></p></div></div>
<%- include('../partials/footer') %>
